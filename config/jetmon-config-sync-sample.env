# Secret config for scripts/jetmon-config-update.sh.
# Store the real file outside the repo and out of Docker images. In production
# this is the one external input mounted or injected into the config-sync
# sidecar; host-side fallback installs may copy it to /etc/jetmon/config-sync.env.

# Either set SVN_URL directly, or set SVNREPO and SVNPATH.
SVN_URL=https://example.invalid/path/to/private/config
# SVNREPO=https://example.invalid/svn-root
# SVNPATH=/path/to/private/config

SVNUSER=replace_me
SVNPASS=replace_me

# Destination for the generated db-servers.php. In the sidecar deployment this
# should be a shared runtime mount such as /jetmon/config-source. In host-side
# fallback deployments it can be a host directory mounted read-only into the
# Monitor container.
JETMON_CONFIG_SYNC_DEST_DIR=/jetmon/config-source

# Optional settings.
JETMON_CONFIG_SYNC_WORK_DIR=/var/lib/jetmon/config-svn
JETMON_CONFIG_SYNC_SOURCE_FILE=db-servers.php
# Empty owner/group skips chown, which is the recommended sidecar behavior
# because the sidecar runs as the unprivileged jetmon user. For host-side
# fallback syncs run as root, set these to jetmon/jetmon.
JETMON_CONFIG_SYNC_OWNER=
JETMON_CONFIG_SYNC_GROUP=
JETMON_CONFIG_SYNC_MODE=0640

# Optional sidecar loop cadence. Keep the interval aligned with
# DB_CONFIG_UPDATES_MIN; the jitter prevents fleet-wide SVN refresh bursts.
JETMON_CONFIG_SYNC_INTERVAL_SEC=600
JETMON_CONFIG_SYNC_JITTER_SEC=120
JETMON_CONFIG_SYNC_INITIAL_JITTER_SEC=120
