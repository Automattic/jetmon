FROM golang:1.26.3 AS builder

WORKDIR /src

ARG JETMON_BUILD_VERSION=dev
ARG JETMON_BUILD_COMMIT=unknown
ARG JETMON_BUILD_DATE=unknown

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X main.version=${JETMON_BUILD_VERSION} -X main.commit=${JETMON_BUILD_COMMIT} -X main.buildDate=${JETMON_BUILD_DATE} -X main.goVersion=$(go version | awk '{print $3}')" \
    -o jetmon2 ./cmd/jetmon2/

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r jetmon && useradd --no-log-init -r -g jetmon jetmon

WORKDIR /jetmon

COPY --from=builder /src/jetmon2 .
COPY config/ config/
COPY migrations/ migrations/
COPY docker/run-jetmon.sh entrypoint.sh
RUN chmod +x entrypoint.sh \
    && mkdir -p stats certs \
    && chown -R jetmon:jetmon /jetmon \
    && chmod 755 stats certs

EXPOSE 8080/tcp 8090/tcp

USER jetmon

ENTRYPOINT ["./entrypoint.sh"]
