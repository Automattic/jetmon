FROM golang:1.26.3 AS builder

WORKDIR /src

ARG JETMON_BUILD_VERSION=dev
ARG JETMON_BUILD_COMMIT=unknown
ARG JETMON_BUILD_DATE=unknown

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-X main.version=${JETMON_BUILD_VERSION} -X main.commit=${JETMON_BUILD_COMMIT} -X main.buildDate=${JETMON_BUILD_DATE} -X main.goVersion=$(go version | awk '{print $3}')" \
    -o veriflier2-bin ./veriflier2/cmd/

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r veriflier && useradd --no-log-init -r -g veriflier veriflier

WORKDIR /opt/veriflier

COPY --from=builder /src/veriflier2-bin ./veriflier2
COPY veriflier2/config/ config/
COPY docker/run-veriflier.sh entrypoint.sh
RUN chmod +x entrypoint.sh \
    && chown -R veriflier:veriflier /opt/veriflier

EXPOSE 7803/tcp

USER veriflier

ENTRYPOINT ["./entrypoint.sh"]
