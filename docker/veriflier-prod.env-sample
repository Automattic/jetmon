VERIFLIER_IMAGE=ghcr.io/automattic/veriflier:latest
VERIFLIER_AUTH_TOKEN=replace_me
VERIFLIER_VANTAGE_ID=replace_me
VERIFLIER_REGION=replace_me
VERIFLIER_PROVIDER=vps
VERIFLIER_BIND_ADDR=127.0.0.1
VERIFLIER_HOST_PORT=7803
CHECK_TARGET_SAFETY_MODE=public_only

# Production Verifliers are public-web services. Caddy terminates HTTPS on
# 80/443 and proxies to the private Veriflier container port.
VERIFLIER_PUBLIC_HOST=nyc-do-jetmon-veriflier-1.example.test
CADDY_ACME_EMAIL=ops@example.test
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Use Let's Encrypt staging while rehearsing to avoid rate limits:
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Optional native TLS paths for deployments that terminate inside veriflier2
# instead of using Caddy. Leave empty for the default Caddy path.
VERIFLIER_TLS_CERT_PATH=
VERIFLIER_TLS_KEY_PATH=

# Stable process identity, for example nyc3.do-nyc3-1. Leave empty only for
# local smoke tests where the Docker runtime hostname is acceptable.
JETMON_HOSTNAME=

# Optional Graphite host path. Leave empty to use JETMON_HOSTNAME. Set this
# when process identity and metric grouping should differ.
STATSD_HOST_PATH=

# Optional Veriflier-specific Graphite host path. Use this when the same Compose
# environment also sets a Monitor-oriented STATSD_HOST_PATH.
VERIFLIER_STATSD_HOST_PATH=

# Bind Graphite to a private/VPN address that central Grafana can reach. Keep
# 127.0.0.1 for local-only smoke tests.
GRAPHITE_BIND_ADDR=127.0.0.1
GRAPHITE_HOST_PORT=8088
STATSD_GRAPHITE_IMAGE=graphiteapp/graphite-statsd
